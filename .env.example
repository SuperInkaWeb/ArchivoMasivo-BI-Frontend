# URL base del backend (datafilter-backend)
VITE_API_URL=http://localhost:8000

# Autenticación (Auth0)
# VITE_AUTH_ENABLED=false SOLO para desarrollo local sin Auth0 (junto con AUTH_ENABLED=false en el backend).
VITE_AUTH_ENABLED=true
# Dominio del tenant (ej. tu-tenant.us.auth0.com) — sin https:// ni barra final.
VITE_AUTH0_DOMAIN=
# Client ID de la aplicación SPA creada en Auth0.
VITE_AUTH0_CLIENT_ID=
# Identifier de la API creada en Auth0 (mismo valor que AUTH0_AUDIENCE del backend).
VITE_AUTH0_AUDIENCE=
